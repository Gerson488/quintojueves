<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="chat1">
        <h1 class="title">CHATBOX</h1>
        <div id="chat">
            <input type="text" id="username" placeholder="Ingrese su nombre de Usuario">
            <div id="messages">
                <div class="message">LeonorSpna:Hola</div>
                <div class="message">LeonorSpna:Hola</div>
            </div>

            <div id="writing">

            </div>
            <textarea id ="write-message" placeholder="Ingrese su mensaje"></textarea>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket=io()
        const username=document.getElementById('username')
        const writeMessage=document.getElementById('write-message')
        const writing=document.getElementById('writing')
        const messages=document.getElementById('messages')

        socket.on('all-messages',(m)=>{
            let content=''
            for(const message of m){
                content+=`
                <div class="message">
                ${message.username}:${message.message}
                </div>
                <br>
                `
            }
            messages.innerHTML=content
            messages.scroll = messages.scrollHeight
        })

        writeMessage.addEventListener('keydown',(event)=>{
            socket.emit('writing', username.value)
        })

        socket.on('writing',(username)=>{
            writing.innerHTML=username+" esta escribiendo..."
            setTimeout(()=>{
                writing.innerHTML=''
            },3000)
        })
        writeMessage.addEventListener('keyup',(event)=>{
            if(event.code=="Enter"){
                if(username.value=="" || writeMessage==""){
                    return alert('El nombre del usuario y el mensaje son requeridos')
                }
                socket.emit('new-message',{
                    username:username.value,message:writeMessage.value.slice(0,-1)
                })
                writeMessage.value=""
            }
        })

    </script>
</body>
</html>